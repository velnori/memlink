{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memlink.dev/memlink-receipt-v1.schema.json",
  "title": "MemLink conversion receipt v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "tool_version",
    "transaction_id",
    "operation",
    "sources",
    "target",
    "filters",
    "excluded",
    "records",
    "plan",
    "outputs",
    "readback",
    "backup",
    "warnings",
    "errors",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "memlink-receipt"
    },
    "version": {
      "const": "1"
    },
    "tool_version": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "export",
        "migrate"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "target": {
      "type": "object"
    },
    "filters": {
      "type": "object"
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identity",
          "id",
          "target_id",
          "outcome",
          "fields"
        ],
        "properties": {
          "identity": {
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "planned",
              "output",
              "conflict"
            ]
          },
          "fields": {
            "type": "object"
          }
        }
      }
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "action"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "action": {
            "enum": [
              "create",
              "unchanged",
              "skip",
              "update"
            ]
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "readback": {
      "type": "object"
    },
    "backup": {
      "type": [
        "object",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "planned",
        "success",
        "partial",
        "failed"
      ]
    }
  }
}
